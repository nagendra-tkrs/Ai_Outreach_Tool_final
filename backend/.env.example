# =========================================================
# AI Client Outreach Backend - FREE Architecture Configuration
# Search: DuckDuckGo ONLY (free) | AI: Ollama ONLY (local + free)
# Do not commit real secrets to this file.
# =========================================================

NODE_ENV=development
PORT=5000
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/ai_client_outreach
FRONTEND_URL=http://localhost:5173

# ---- Database Backend (Optional: firestore | mongodb) ----
# Defaults to 'mongodb'. When 'firestore' is selected, configure project/emulator:
# DATABASE_BACKEND=mongodb
# FIRESTORE_PROJECT_ID=ai-client-outreach-dev
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_APPLICATION_CREDENTIALS=config/firebase-service-account.json

# ---- Crawler sized limits ----
MAX_PAGES_PER_COMPANY=20
MAX_CRAWL_DEPTH=2
MAX_PAGE_SIZE=5000000
CRAWL_CONCURRENCY=3

# ---- Web Search: DuckDuckGo ONLY (free) ----
# The ONLY active search provider. No paid/credit-based search API is used.
SEARCH_PROVIDER=duckduckgo
SEARCH_TIMEOUT_MS=30000
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_DELAY_MS=1500
MAX_WEB_SEARCH_QUERIES=20
MAX_SEARCH_RESULTS_PER_QUERY=5

# Controlled error states (never silently fall back to a paid provider):
# SEARCH_TIMEOUT | SEARCH_BLOCKED | SEARCH_UNAVAILABLE | NO_RESULTS

# ---- AI: Ollama ONLY (local + free) ----
# No GEMINI_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY is required.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REQUEST_TIMEOUT=600000

# Optional AI-level fallback timeout for non-Ollama providers (unused in free mode)
AI_REQUEST_TIMEOUT=120000

# ---- Research / crawl timeouts ----
# RESEARCH_TIMEOUT_MS bounds the total wall-clock time of a research run.
RESEARCH_TIMEOUT_MS=600000
# CRAWLER_TIMEOUT_MS is the per-request page-fetch budget (falls back to REQUEST_TIMEOUT).
CRAWLER_TIMEOUT_MS=30000
REQUEST_TIMEOUT=10000
MAX_RETRIES=2

# ---- Scheduler Kill Switch (Safe Default: false) ----
# Set to 'true' only when ready for the 60s background worker to auto-dispatch due follow-up emails.
ENABLE_SCHEDULER=false

# ---- Security & Authentication (Dashboard Access) ----
# Admin dashboard credentials (server-side protection for all data, settings, and email dispatch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
AUTH_SECRET_KEY=generate_a_random_32_character_secret_key
# Optional: static API key for scripts or CI automation
ADMIN_API_KEY=
AUTH_TOKEN_EXPIRE_HOURS=24

