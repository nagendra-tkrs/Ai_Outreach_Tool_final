# AI Client Outreach - FREE Architecture Configuration
# Search: DuckDuckGo ONLY (free). AI: Ollama ONLY (local + free). DB: local MongoDB.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_client_outreach
FRONTEND_URL=http://localhost:5173

# ---- Search: DuckDuckGo ONLY (free) ----
# SEARCH_PROVIDER=duckduckgo   # only DuckDuckGo is supported
# SEARCH_TIMEOUT_MS=30000      # per search request budget
# SEARCH_MAX_RETRIES=2         # bounded retries for transient failures
# SEARCH_RETRY_DELAY_MS=1500   # delay between retries
# MAX_WEB_SEARCH_QUERIES=20    # max distinct queries per discovery run
# MAX_SEARCH_RESULTS_PER_QUERY=5

# ---- AI: Ollama ONLY (local + free), no API keys required ----
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5-coder:7b-instruct
# OLLAMA_REQUEST_TIMEOUT=600000

# ---- Research / crawl timeouts ----
# RESEARCH_TIMEOUT_MS=600000
# CRAWLER_TIMEOUT_MS=30000
# REQUEST_TIMEOUT=10000         # fallback page-fetch timeout (per request)
# MAX_RETRIES=2
# MAX_PAGES_PER_COMPANY=20
# MAX_CRAWL_DEPTH=2
# MAX_PAGE_SIZE=5000000
# CRAWL_CONCURRENCY=3
